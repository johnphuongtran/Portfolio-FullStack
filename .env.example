# Copy to `.env.local` for development (never commit secrets).

# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where inbound messages are delivered
CONTACT_TO_EMAIL=you@example.com

# Optional. Must be an address/domain you are allowed to send from in Resend.
# For quick tests Resend often documents using onboarding@resend.dev — confirm in Resend dashboard/docs.
# For production, verify your domain and use e.g. Portfolio <contact@yourdomain.com>
RESEND_FROM=Portfolio <onboarding@resend.dev>
